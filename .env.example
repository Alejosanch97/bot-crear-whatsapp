# Copia este archivo como .env (cp .env.example .env) y llena los valores.
# El .env NUNCA se sube a GitHub (está en .gitignore).

# ---------- Meta / WhatsApp ----------
# Token: Paso 1 "Pruébalo" en developers.facebook.com (el temporal dura 24 h)
WA_TOKEN=
# Phone Number ID del número que usa el bot
WA_PHONE_ID=1359037787302056
# La misma clave que pusiste en Meta → Webhooks → Token de verificación
VERIFY_TOKEN=crear123
GRAPH_VERSION=v25.0
# Opcional: Configuración de la app → Básica → Clave secreta de la app
APP_SECRET=

# ---------- Dirección pública ----------
# En tu Mac: la URL de ngrok. En Render: https://tu-app.onrender.com
BASE_URL=https://squatting-ludicrous-ninetieth.ngrok-free.dev

# ---------- Administración ----------
# Números que reciben las notificaciones (separados por coma, con 57 adelante)
ADMIN_NUMEROS=57XXXXXXXXXX
# Clave para abrir la página /registros (inventa una)
ADMIN_KEY=cambia-esta-clave

# ---------- Supabase (opcional, recomendado en Render) ----------
SUPABASE_URL=
SUPABASE_KEY=

# ---------- Plantilla de notificación (opcional) ----------
NOTIF_TEMPLATE=
NOTIF_TEMPLATE_LANG=es
